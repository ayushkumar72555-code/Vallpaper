<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lyrics_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:clipChildren="true"
    android:background="@drawable/lyrics_widget_background">

    <TextView
        android:id="@+id/lyrics_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:layout_width="32dp"
        android:layout_height="2dp"
        android:layout_gravity="center"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#FFFFFF"
        android:text="" />

    <!-- The lyrics area is explicitly divided into a flexible current-line
         viewport and a fixed next-line row. The next line therefore cannot
         be pushed outside the widget when the host changes its size. -->
    <LinearLayout
        android:id="@+id/lyrics_widget_lyrics_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:clipChildren="true"
        android:clipToPadding="true">

        <!-- Flexible viewport. Its height comes from the available widget
             space instead of being hard-coded. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:clipChildren="true"
            android:clipToPadding="true">

            <ViewFlipper
                android:id="@+id/lyrics_widget_current_flipper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:animateFirstView="false"
                android:inAnimation="@anim/widget_lyrics_slide_in"
                android:outAnimation="@anim/widget_lyrics_slide_out">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/lyrics_widget_current_a_sans"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:shadowColor="#BFFFFFFF"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="8"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/lyrics_widget_current_a_serif"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:fontFamily="serif"
                        android:shadowColor="#BFFFFFFF"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="8"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/lyrics_widget_current_a_mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:shadowColor="#BFFFFFFF"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="8"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/lyrics_widget_current_b_sans"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:shadowColor="#BFFFFFFF"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="8"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/lyrics_widget_current_b_serif"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:fontFamily="serif"
                        android:shadowColor="#BFFFFFFF"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="8"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/lyrics_widget_current_b_mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:shadowColor="#BFFFFFFF"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="8"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="gone" />
                </FrameLayout>
            </ViewFlipper>
        </FrameLayout>

        <!-- Dedicated next-line row. It always receives its own measured
             height, so it cannot be vertically clipped by the current line. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/lyrics_widget_next_a_sans"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#666B73"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/lyrics_widget_next_a_serif"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#666B73"
                android:textSize="12sp"
                android:fontFamily="serif"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lyrics_widget_next_a_mono"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#666B73"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
