<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lyrics_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="18dp"
    android:background="@drawable/lyrics_widget_background">

    <FrameLayout
        android:id="@+id/lyrics_widget_lyrics_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/lyrics_widget_current_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <TextView
                android:id="@+id/lyrics_widget_current_sans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:shadowColor="#BFFFFFFF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8" />

            <TextView
                android:id="@+id/lyrics_widget_current_serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:shadowColor="#BFFFFFFF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lyrics_widget_current_mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:shadowColor="#BFFFFFFF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:visibility="gone" />
        </FrameLayout>

    </FrameLayout>

</LinearLayout>
