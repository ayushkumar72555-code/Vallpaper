<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lyrics_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="18dp"
    android:background="@drawable/lyrics_widget_background">

    <TextView
        android:id="@+id/lyrics_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:layout_width="32dp"
        android:layout_height="2dp"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="#FFFFFF"
        android:text="" />

    <FrameLayout
        android:id="@+id/lyrics_widget_lyrics_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/lyrics_widget_current_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <TextView
                android:id="@+id/lyrics_widget_current_sans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:shadowColor="#BFFFFFFF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/lyrics_widget_current_serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:shadowColor="#BFFFFFFF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lyrics_widget_current_mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:shadowColor="#BFFFFFFF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/lyrics_widget_next_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="62dp">

            <TextView
                android:id="@+id/lyrics_widget_next_sans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#666B73"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/lyrics_widget_next_serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#666B73"
                android:textSize="12sp"
                android:fontFamily="serif"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lyrics_widget_next_mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#666B73"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

</LinearLayout>
